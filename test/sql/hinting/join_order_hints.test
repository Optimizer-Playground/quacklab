# syntax errors in the hint block
#

# the outer parentheses are required
statement error
EXPLAIN /*=quack_lab= JoinOrder(t mi) */ SELECT count(*) FROM t JOIN mi ON t.id = mi.movie_id;
----
Syntax error in quack_lab hint block

query I
SELECT count(*) FROM t JOIN mi ON t.id = mi.movie_id;
----
5000

statement error
EXPLAIN /*=quack_lab= JoinOrder(((t))) */ SELECT * FROM t;
----
Syntax error in quack_lab hint block

query I
SELECT count(*) FROM t JOIN mi ON t.id = mi.movie_id;
----
5000

statement error
EXPLAIN /*=quack_lab= JoinOrder((t mi) */ SELECT count(*) FROM t JOIN mi ON t.id = mi.movie_id;
----
Syntax error in quack_lab hint block

query I
SELECT count(*) FROM t JOIN mi ON t.id = mi.movie_id;
----
5000
